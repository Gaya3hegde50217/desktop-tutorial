      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Constants\n",
        "rho_mars = 0.015      # kg/m³ - Martian atmosphere\n",
        "rho_h2_mars = 0.00068 # kg/m³ - Hydrogen at Mars conditions\n",
        "dbm = 0.0508          # Envelope areal density kg/m² (Mylar/Nylon)\n",
        "g_mars = 3.72         # m/s²\n",
        "\n",
        "# Radius range\n",
        "radius = np.linspace(5, 50, 100)   # from 5m to 50m\n",
        "\n",
        "def net_payload_kg(r, rho_air, rho_gas, fabric_density):\n",
        "    V = (4/3) * np.pi * r**3\n",
        "    A = 4 * np.pi * r**2\n",
        "    net_mass = V * (rho_air - rho_gas) - fabric_density * A\n",
        "    return net_mass\n",
        "\n",
        "# Calculate net payload (kg)\n",
        "payload_mars = net_payload_kg(radius, rho_mars, rho_h2_mars, dbm)\n",
        "\n",
        "# Plot\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "plt.plot(radius, payload_mars, 'b-', linewidth=2.5, label='Mars (Hydrogen Balloon)')\n",
        "plt.axhline(y=0, color='r', linestyle='--', alpha=0.7, label='Zero Lift Line')\n",
        "\n",
        "plt.xlabel('Balloon Radius (m)', fontsize=12)\n",
        "plt.ylabel('Net Payload Capacity (kg)', fontsize=12)\n",
        "plt.title('Net Lift vs Balloon Radius on Mars\\n(ρ_air = 0.015 kg/m³, Fabric = 0.0508 kg/m²)', fontsize=14)\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.legend(fontsize=11)\n",
        "\n",
        "# Add some useful annotations\n",
        "plt.annotate('18m Radius (Original Report)', xy=(18, net_payload_kg(18, rho_mars, rho_h2_mars, dbm)),\n",
        "             xytext=(22, 80), arrowprops=dict(arrowstyle='->', color='blue'))\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Print table for report\n",
        "print(\"Radius (m) | Diameter (m) | Volume (m³) | Net Payload (kg)\")\n",
        "for r in [10, 15, 18, 20, 25, 30, 40, 50]:\n",
        "    V = (4/3)*np.pi*r**3\n",
        "    payload = net_payload_kg(r, rho_mars, rho_h2_mars, dbm)\n",
        "    diam = 2 * r\n",
        "    print(f\"{r:10.1f} | {diam:11.1f} | {V:11.0f} | {payload:12.1f}\")"
      ],
