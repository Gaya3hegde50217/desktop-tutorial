        "# Re-train Random Forest with resampled data\n",
        "rf_smote = RandomForestClassifier(n_estimators=150, criterion='gini', max_depth=12, random_state=42)\n",
        "rf_smote.fit(X_train_res, y_train_res)\n",
        "\n",
        "# Evaluate the model with SMOTE\n",
