      },
      "source": [
        "# URLs for active satellites (payloads) and debris\n",
        "url_active = 'https://celestrak.org/satcat/records.php?GROUP=ACTIVE&FORMAT=CSV'\n",
        "url_debris = 'https://celestrak.org/satcat/records.php?SPECIAL=RB&FORMAT=CSV'\n",
        "\n",
        "# Load active satellites data\n",
        "try:\n",
        "    active_df = pd.read_csv(url_active)\n",
        "    print(f\"Loaded {len(active_df)} active satellites.\")\n",
        "except Exception as e:\n",
        "    print(f\"Error loading active satellites data: {e}\")\n",
        "\n",
        "# Load debris data\n",
        "try:\n",
        "    debris_df = pd.read_csv(url_debris)\n",
        "    print(f\"Loaded {len(debris_df)} rocket body objects.\")\n",
        "except Exception as e:\n",
        "    print(f\"Error loading rocket body data: {e}\")"
