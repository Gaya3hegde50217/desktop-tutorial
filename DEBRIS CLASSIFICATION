        "\n",
        "label_to_int = {'fragment': 0, 'rocket_body': 1, 'payload': 2}\n",
        "int_to_label = {v: k for k, v in label_to_int.items()}\n",
        "\n",
        "def generate_synthetic_image(class_name):\n",
        "    img = np.zeros(image_size, dtype=np.float32)\n",
        "    rr = np.tile(np.arange(64)[:, np.newaxis], (1, 64))\n",
        "    cc = np.tile(np.arange(64)[np.newaxis, :], (64, 1))\n",
        "    if class_name == 'fragment':\n",
        "        mask = (rr > 10) & (rr < 50) & (cc > 10) & (cc < 30)\n",
        "        img[:,:,0][mask] = 255  # Red-dominant\n",
        "    elif class_name == 'rocket_body':\n",
        "        mask = (rr > 10) & (rr < 50) & (cc > 10) & (cc < 50)\n",
        "        img[:,:,1][mask] = 255  # Green-dominant\n",
        "    elif class_name == 'payload':\n",
        "        mask = (rr > 15) & (rr < 45) & (cc > 15) & (cc < 45)\n",
        "        img[:,:,2][mask] = 255  # Blue-dominant\n",
        "    noise = np.random.randint(0, 20, image_size)  # Low noise for perfect separation\n",
        "    img += noise\n",
        "    img = np.clip(img, 0, 255)\n",
        "    return img\n",
        "\n",
        "# Generate dataset\n",
