        "import os\n",
        "import pandas as pd\n",
        "import ast\n",
        "from PIL import Image, ImageDraw\n",
        "from IPython.display import display as display_image\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.fft import fft2, fftshift\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.optim as optim\n",
        "from torch.utils.data import Dataset, DataLoader\n",
        "import kagglehub\n",
        "\n",
        "# Define the dataset ID\n",
        "dataset_id = \"sadianawar/debris-detection-dataset\"\n",
        "\n",
        "# Download the dataset (if not already cached) and get its local path\n",
        "dataset_path = kagglehub.dataset_download(dataset_id)\n",
        "\n",
        "# Assuming the images are in the 'debris-detection/train' directory\n",
        "# Use the dataset_path from kagglehub.dataset_download for robustness\n",
        "# dataset_path is available in the kernel state from a previous cell (bc659897)\n",
        "# e.g., dataset_path = '/kaggle/input/debris-detection-dataset'\n",
        "image_dir = os.path.join(dataset_path, \"debris-detection\", \"train\")\n",
        "\n",
        "# Convert 'bboxes' column from string to list of lists\n",
        "# This line is likely no longer needed if kagglehub.load_dataset already parses it correctly.\n",
        "# df['bboxes'] = df['bboxes'].apply(ast.literal_eval)\n",
        "\n",
        "# Create an output directory for images with bounding boxes\n",
        "output_image_dir = \"output_images\"\n",
        "os.makedirs(output_image_dir, exist_ok=True)\n",
        "\n",
        "# Create an output directory for ISAR images\n",
        "isar_output_dir = \"isar_images\"\n",
        "os.makedirs(isar_output_dir, exist_ok=True)\n",
        "\n",
        "print(f\"Processing images. Output images with bounding boxes will be saved to: {output_image_dir}\")\n",
        "print(f\"ISAR images will be saved to: {isar_output_dir}\")\n",
        "\n",
        "actual_image_filenames = [] # Initialize to an empty list to prevent NameError\n",
        "\n",
        "# Get sorted list of actual image filenames from the directory\n",
        "if os.path.exists(image_dir):\n",
        "    actual_image_filenames = sorted([f for f in os.listdir(image_dir) if f.endswith('.jpg')])\n",
        "else:\n",
        "    print(f\"Error: Image directory not found at {image_dir}\")\n",
        "\n",
        "\n",
        "if actual_image_filenames: # Only proceed if image files were found\n",
        "    # Process all images\n",
        "    for index, row in df.iterrows():\n",
        "        df_image_id = row['ImageID'] # This is 0, 1, 2, ... from the DataFrame\n",
        "        bboxes = row['bboxes']\n",
        "\n",
        "        if df_image_id < len(actual_image_filenames):\n",
        "            image_filename = actual_image_filenames[df_image_id] # Get filename from sorted list\n",
        "            image_path = os.path.join(image_dir, image_filename)\n",
        "\n",
        "            if os.path.exists(image_path):\n",
        "                try:\n",
        "                    img = Image.open(image_path).convert(\"RGB\")\n",
        "                    draw = ImageDraw.Draw(img)\n",
        "\n",
        "                    for bbox_idx, bbox in enumerate(bboxes):\n",
        "                        # bbox format: [x_min, y_min, width, height]\n",
        "                        x_min, y_min, width, height = bbox\n",
        "                        x_max = x_min + width\n",
        "                        y_max = y_min + height\n",
        "                        draw.rectangle([x_min, y_min, x_max, y_max], outline=\"red\", width=2)\n",
        "\n",
        "                        # Crop the debris region\n",
        "                        crop = img.crop((x_min, y_min, x_max, y_max))\n",
        "\n",
        "                        # Convert crop to grayscale numpy array\n",
        "                        gray_crop = np.array(crop.convert('L'))\n",
        "\n",
        "                        # Simulate ISAR-like image using 2D FFT (rough approximation of range-Doppler map)\n",
        "                        # Apply FFT, shift, take log magnitude for visualization\n",
        "                        fft_data = fftshift(fft2(gray_crop))\n",
        "                        isar_mag = np.log(np.abs(fft_data) + 1e-10)  # Avoid log(0)\n",
        "\n",
        "                        # Normalize to [0, 255] for image saving\n",
        "                        isar_mag_norm = (isar_mag - isar_mag.min()) / (isar_mag.max() - isar_mag.min()) * 255\n",
        "                        isar_img = Image.fromarray(isar_mag_norm.astype(np.uint8))\n",
        "\n",
        "                        # Save ISAR image\n",
        "                        isar_filename = f\"{image_filename.split('.')[0]}_bbox{bbox_idx}_isar.jpg\"\n",
        "                        isar_path = os.path.join(isar_output_dir, isar_filename)\n",
        "                        isar_img.save(isar_path)\n",
        "\n",
        "                    # Save the image with bounding boxes\n",
        "                    output_path = os.path.join(output_image_dir, f\"{image_filename.split('.')[0]}_with_bboxes.jpg\")\n",
        "                    img.save(output_path)\n",
        "\n",
        "                    # For a large dataset, displaying all images might make the notebook very slow or crash.\n",
        "                    # Temporarily disabling display to avoid excessive output, user can re-enable if needed.\n",
        "                    # display_image(img)\n",
        "\n",
        "                except Exception as e:\n",
        "                    print(f\"Error processing image {image_filename}: {e}\")\n",
        "            else:\n",
        "                print(f\"Image file not found for ImageID {df_image_id} at {image_path}\")\n",
        "        else:\n",
        "            print(f\"Error: ImageID {df_image_id} from DataFrame is out of bounds for the actual image file list (length {len(actual_image_filenames)}).\")\n",
        "\n",
        "    print(\"Finished processing all images.\")\n",
        "else:\n",
        "    print(\"Skipping image processing due to missing image directory or no image files found.\")\n",
        "\n",
        "# --- Classification Section ---\n",
        "\n",
        "# Assuming classes: 'fragment', 'rocket_body', 'payload' (train on synthetic ISAR for demo)\n",
        "classes = ['fragment', 'rocket_body', 'payload']\n",
        "num_classes = len(classes)\n",
        "image_size = (64, 64)  # Resize ISAR to this\n",
        "\n",
        "# Focal Loss for better training\n",
        "class FocalLoss(nn.Module):\n",
        "    def __init__(self, alpha=0.25, gamma=2.0, reduction='mean'):\n",
        "        super(FocalLoss, self).__init__()\n",
        "        self.alpha = alpha\n",
        "        self.gamma = gamma\n",
        "        self.reduction = reduction\n",
        "\n",
        "    def forward(self, inputs, targets):\n",
        "        ce_loss = nn.CrossEntropyLoss(reduction='none')(inputs, targets)\n",
        "        pt = torch.exp(-ce_loss)\n",
        "        f_loss = self.alpha * (1 - pt) ** self.gamma * ce_loss\n",
        "        if self.reduction == 'mean':\n",
        "            return torch.mean(f_loss)\n",
        "        else:\n",
        "            return torch.sum(f_loss)\n",
        "\n",
        "# CNN Model\n",
        "class DebrisCNN(nn.Module):\n",
        "    def __init__(self, num_classes=num_classes):\n",
        "        super(DebrisCNN, self).__init__()\n",
        "        self.conv1 = nn.Conv2d(1, 32, kernel_size=3, padding=1)  # Grayscale ISAR\n",
        "        self.pool = nn.MaxPool2d(2, 2)\n",
        "        self.conv2 = nn.Conv2d(32, 64, kernel_size=3, padding=1)\n",
        "        self.fc1 = nn.Linear(64 * 16 * 16, 128)\n",
        "        self.fc2 = nn.Linear(128, num_classes)\n",
        "        self.relu = nn.ReLU()\n",
        "\n",
        "    def forward(self, x):\n",
        "        x = self.pool(self.relu(self.conv1(x)))\n",
        "        x = self.pool(self.relu(self.conv2(x)))\n",
        "        x = x.view(-1, 64 * 16 * 16)\n",
        "        x = self.relu(self.fc1(x))\n",
        "        x = self.fc2(x)\n",
        "        return x\n",
        "\n",
        "# For demo, train on synthetic ISAR (distinct patterns for high accuracy)\n",
        "num_samples_per_class = 100\n",
        "label_to_int = {cls: i for i, cls in enumerate(classes)}\n",
        "\n",
        "def generate_synthetic_isar(class_name):\n",
        "    img = np.zeros(image_size, dtype=np.float32)\n",
        "    if class_name == 'fragment':\n",
        "        img[10:50, 10:30] = 255  # Simple pattern\n",
        "    elif class_name == 'rocket_body':\n",
        "        img[10:50, 10:50] = 255\n",
        "    elif class_name == 'payload':\n",
        "        img[15:45, 15:45] = 255\n",
        "    # Apply FFT to make \"ISAR-like\"\n",
        "    fft_data = fftshift(fft2(img))\n",
        "    isar_mag = np.log(np.abs(fft_data) + 1e-10)\n",
        "    isar_mag_norm = (isar_mag - isar_mag.min()) / (isar_mag.max() - isar_mag.min()) * 255\n",
        "    return isar_mag_norm.astype(np.uint8)\n",
        "\n",
        "# Generate synthetic dataset\n",
        "synth_data = []\n",
        "synth_labels = []\n",
        "for cls in classes:\n",
        "    for _ in range(num_samples_per_class):\n",
        "        isar = generate_synthetic_isar(cls)\n",
        "        synth_data.append(isar)\n",
        "        synth_labels.append(label_to_int[cls])\n",
        "\n",
        "# Split\n",
        "train_idx = int(0.8 * len(synth_data))\n",
        "train_data, test_data = synth_data[:train_idx], synth_data[train_idx:]\n",
        "train_labels, test_labels = synth_labels[:train_idx], synth_labels[train_idx:]\n",
        "\n",
        "class ISARDataset(Dataset):\n",
        "    def __init__(self, images, labels):\n",
        "        self.images = images\n",
        "        self.labels = torch.tensor(labels, dtype=torch.long)\n",
        "\n",
        "    def __len__(self):\n",
        "        return len(self.labels)\n",
        "\n",
        "    def __getitem__(self, idx):\n",
        "        img = self.images[idx]\n",
        "        img = (img / 127.5) - 1.0  # Normalize\n",
        "        img = torch.from_numpy(img).float().unsqueeze(0)  # Grayscale, add channel\n",
        "        return img, self.labels[idx]\n",
        "\n",
        "train_dataset = ISARDataset(train_data, train_labels)\n",
        "test_dataset = ISARDataset(test_data, test_labels)\n",
        "\n",
        "train_loader = DataLoader(train_dataset, batch_size=32, shuffle=True)\n",
        "test_loader = DataLoader(test_dataset, batch_size=32, shuffle=False)\n",
        "\n",
        "model = DebrisCNN()\n",
        "criterion = FocalLoss()\n",
        "optimizer = optim.Adam(model.parameters(), lr=0.001)\n",
        "\n",
        "# Training\n",
        "num_epochs = 20\n",
        "for epoch in range(num_epochs):\n",
        "    model.train()\n",
        "    for images, labels in train_loader:\n",
        "        optimizer.zero_grad()\n",
        "        outputs = model(images)\n",
        "        loss = criterion(outputs, labels)\n",
        "        loss.backward()\n",
        "        optimizer.step()\n",
        "    print(f'Epoch {epoch+1}/{num_epochs} complete')\n",
        "\n",
        "# Evaluation\n",
        "model.eval()\n",
        "correct = 0\n",
        "total = 0\n",
        "with torch.no_grad():\n",
        "    for images, labels in test_loader:\n",
        "        outputs = model(images)\n",
        "        _, predicted = torch.max(outputs.data, 1)\n",
        "        total += labels.size(0)\n",
        "        correct += (predicted == labels).sum().item()\n",
        "\n",
        "accuracy = 100 * correct / total\n",
        "print(f'Synthetic ISAR Test Accuracy: {accuracy:.2f}%')\n",
        "\n",
        "# Save model\n",
        "torch.save(model.state_dict(), 'isar_debris_classifier.pth')\n",
        "\n",
        "# Function to classify generated ISAR images\n",
        "def classify_isar_images(model_path='isar_debris_classifier.pth', isar_dir=isar_output_dir):\n",
        "    model = DebrisCNN()\n",
        "    model.load_state_dict(torch.load(model_path))\n",
        "    model.eval()\n",
        "    predictions = {}\n",
        "    for isar_file in os.listdir(isar_dir):\n",
        "        if isar_file.endswith('.jpg'):\n",
        "            isar_path = os.path.join(isar_dir, isar_file)\n",
        "            img = Image.open(isar_path).convert('L') # PIL Image\n",
